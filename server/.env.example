NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://nexanft:replace-with-a-local-password@localhost:5433/nexanft?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
TRUST_PROXY=0
ENABLE_DEMO_TRANSFERS=true
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=nexanft
# On a physical device, replace localhost with your computer's LAN IP.
STORAGE_PUBLIC_URL=http://localhost:4000/media
STORAGE_FORCE_PATH_STYLE=false
RESET_URL=nexanft://reset-password
MAIL_PROVIDER=smtp
# Optional in development. A mail provider is required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NexaNFT <hello@example.com>
