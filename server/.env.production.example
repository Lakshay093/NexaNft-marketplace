NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://APP_USER:REPLACE_PASSWORD@YOUR_DB_HOST:5432/nexanft?sslmode=require
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
CORS_ORIGINS=https://YOUR_MOBILE_WEB_DOMAIN,https://YOUR_LANDING_DOMAIN
# Render has one trusted reverse proxy. Change for your actual proxy topology.
TRUST_PROXY=1
ENABLE_DEMO_TRANSFERS=false
STORAGE_DRIVER=s3
# public = S3/R2 CDN reads; proxy = private bucket served through API /media.
STORAGE_DELIVERY=public
STORAGE_REGION=YOUR_REGION
# Optional for S3-compatible services such as Cloudflare R2.
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=REPLACE_ACCESS_KEY
STORAGE_SECRET_KEY=REPLACE_STORAGE_SECRET
STORAGE_BUCKET=YOUR_BUCKET
STORAGE_PUBLIC_URL=https://YOUR_MEDIA_CDN_DOMAIN
STORAGE_FORCE_PATH_STYLE=false
RESET_URL=nexanft://reset-password
# Railway Free/Trial/Hobby blocks SMTP; use Brevo's HTTPS API.
MAIL_PROVIDER=brevo
MAIL_FROM_EMAIL=YOUR_VERIFIED_SENDER_EMAIL
MAIL_FROM_NAME=NexaNFT
BREVO_API_KEY=REPLACE_BREVO_API_KEY
# Alternative SMTP provider (set MAIL_PROVIDER=smtp on a host that allows SMTP).
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASS=REPLACE_SMTP_PASSWORD
SMTP_FROM=NexaNFT <hello@YOUR_VERIFIED_EMAIL_DOMAIN>
