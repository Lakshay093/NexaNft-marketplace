{
  "name": "@nexanft/server",
  "version": "1.0.0",
  "author": "Lakshay Dhiman",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server/src/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nexanft/contracts": "1.0.0",
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "@aws-sdk/client-s3": "^3.950.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.76",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "@types/express": "^5.0.3",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.3",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3"
  }
}
