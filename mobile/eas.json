{
  "cli": { "version": ">=16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "node": "22.22.0",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_ENABLE_DEMO_TRANSFERS": "true",
        "EXPO_PUBLIC_API_URL": "http://192.168.0.101:4000/api"
      }
    },
    "preview": {
      "node": "22.22.0",
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_ENABLE_DEMO_TRANSFERS": "true",
        "EXPO_PUBLIC_API_URL": "http://192.168.0.101:4000/api"
      }
    },
    "cloud": {
      "extends": "production",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_ENABLE_DEMO_TRANSFERS": "true" }
    },
    "production": {
      "node": "22.22.0",
      "environment": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "EXPO_PUBLIC_ENABLE_DEMO_TRANSFERS": "false" }
    }
  }
}
